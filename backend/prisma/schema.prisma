generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// Core Tenant & Identity
// ─────────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logoUrl     String?
  tagline     String?
  description String?  @db.Text
  website     String?
  email       String
  phone       String
  whatsapp    String?
  address     String?
  city        String?
  country     String?
  timezone    String   @default("UTC")
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users           User[]
  customers       Customer[]
  fleet           Fleet[]
  services        Service[]
  gallery         Gallery[]
  blogPosts       BlogPost[]
  testimonials    Testimonial[]
  pricingRules    PricingRule[]
  transportRequests TransportRequest[]
  quotes          Quote[]
  notifications   Notification[]
  settings        Setting?

  @@index([slug])
  @@index([isActive])
  @@map("companies")
}

enum UserRole {
  ADMIN
  MANAGER
  DISPATCHER
  DRIVER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

model User {
  id            String     @id @default(cuid())
  companyId     String
  email         String
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatarUrl     String?
  role          UserRole   @default(MANAGER)
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  emailVerified Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  notifications Notification[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────
// Customers & Bookings
// ─────────────────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String
  phone     String
  address   String?
  city      String?
  country   String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transportRequests TransportRequest[]

  @@index([companyId])
  @@index([email])
  @@index([phone])
  @@map("customers")
}

enum CargoType {
  GENERAL
  PERISHABLE
  FRAGILE
  HEAVY_MACHINERY
  HAZARDOUS
  LIQUID
  VEHICLES
  LIVESTOCK
  CONTAINER
  OTHER
}

enum VehicleType {
  VAN
  PICKUP
  TRUCK_1_TON
  TRUCK_3_TON
  TRUCK_5_TON
  TRUCK_10_TON
  TRUCK_20_TON
  TRAILER
  REFRIGERATED
  TANKER
  FLATBED
  LOWBED
}

enum RequestStatus {
  REQUEST_SUBMITTED
  QUOTE_PREPARED
  BOOKING_CONFIRMED
  LOADING
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

model TransportRequest {
  id                String        @id @default(cuid())
  companyId         String
  customerId        String?
  referenceNumber   String        @unique
  name              String
  email             String
  phone             String
  pickupLocation    String
  pickupLat         Float?
  pickupLng         Float?
  destination       String
  destinationLat    Float?
  destinationLng    Float?
  cargoType         CargoType
  weight            Float // in kg
  vehicleType       VehicleType
  preferredPickupDate DateTime?
  notes             String?       @db.Text
  estimatedDistance Float?        // in km
  estimatedPrice    Decimal?      @db.Decimal(12, 2)
  status            RequestStatus @default(REQUEST_SUBMITTED)
  source            String        @default("website") // website, whatsapp, phone, email
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  quotes   Quote[]
  statusHistory StatusHistory[]

  @@index([companyId])
  @@index([referenceNumber])
  @@index([status])
  @@index([createdAt])
  @@index([companyId, status])
  @@map("transport_requests")
}

model StatusHistory {
  id          String        @id @default(cuid())
  requestId   String
  status      RequestStatus
  note        String?       @db.Text
  createdById String?
  createdAt   DateTime      @default(now())

  request TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([createdAt])
  @@map("status_history")
}

model Quote {
  id              String   @id @default(cuid())
  companyId       String
  requestId       String
  basePrice       Decimal  @db.Decimal(12, 2)
  distancePrice   Decimal  @db.Decimal(12, 2)
  weightPrice     Decimal  @db.Decimal(12, 2)
  vehiclePrice    Decimal  @db.Decimal(12, 2)
  extrasPrice     Decimal  @default(0) @db.Decimal(12, 2)
  taxPrice        Decimal  @default(0) @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  currency        String
  distanceKm      Float?
  notes           String?  @db.Text
  validUntil      DateTime?
  isAccepted      Boolean  @default(false)
  acceptedAt      DateTime?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  request TransportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([requestId])
  @@map("quotes")
}

// ─────────────────────────────────────────────────────────────────
// Pricing
// ─────────────────────────────────────────────────────────────────

enum PricingRuleType {
  BASE_FEE
  PER_KM
  PER_KG
  VEHICLE_SURCHARGE
  CARGO_SURCHARGE
  MINIMUM_FEE
  EXTRA_STOP
}

model PricingRule {
  id          String          @id @default(cuid())
  companyId   String
  name        String
  type        PricingRuleType
  vehicleType VehicleType?
  cargoType   CargoType?
  value       Decimal         @db.Decimal(12, 4)
  minWeight   Float?
  maxWeight   Float?
  minDistance Float?
  maxDistance Float?
  isActive    Boolean         @default(true)
  priority    Int             @default(0)
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([isActive])
  @@index([companyId, type, isActive])
  @@map("pricing_rules")
}

// ─────────────────────────────────────────────────────────────────
// Fleet & Services
// ─────────────────────────────────────────────────────────────────

enum FleetStatus {
  ACTIVE
  MAINTENANCE
  IN_TRANSIT
  RETIRED
}

model Fleet {
  id          String      @id @default(cuid())
  companyId   String
  name        String
  type        VehicleType
  capacityKg  Float
  status      FleetStatus @default(ACTIVE)
  description String?     @db.Text
  features    String[]
  images      FleetImage[]
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
  @@index([sortOrder])
  @@map("fleet")
}

model FleetImage {
  id       String @id @default(cuid())
  fleetId  String
  url      String
  publicId String?
  sortOrder Int   @default(0)

  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@map("fleet_images")
}

model Service {
  id          String   @id @default(cuid())
  companyId   String
  title       String
  slug        String
  summary     String?
  description String?  @db.Text
  icon        String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("services")
}

// ─────────────────────────────────────────────────────────────────
// Content Management
// ─────────────────────────────────────────────────────────────────

model Gallery {
  id          String   @id @default(cuid())
  companyId   String
  title       String?
  description String?  @db.Text
  imageUrl    String
  publicId    String?
  category    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isActive])
  @@index([category])
  @@map("gallery")
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id          String         @id @default(cuid())
  companyId   String
  title       String
  slug        String
  excerpt     String?
  content     String         @db.Text
  coverImage  String?
  authorId    String
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  metaTitle   String?
  metaDescription String?
  tags        String[]
  viewCount   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
  @@index([status])
  @@index([publishedAt])
  @@index([companyId, status, publishedAt])
  @@map("blog_posts")
}

model Testimonial {
  id        String   @id @default(cuid())
  companyId String
  author    String
  role      String?
  company   String?
  content   String   @db.Text
  rating    Int      @default(5)
  avatarUrl String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyRel Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([isActive])
  @@map("testimonials")
}

// ─────────────────────────────────────────────────────────────────
// Notifications & Settings
// ─────────────────────────────────────────────────────────────────

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

model Notification {
  id        String               @id @default(cuid())
  companyId String
  userId    String?
  channel   NotificationChannel
  recipient String
  subject   String?
  content   String               @db.Text
  status    NotificationStatus   @default(PENDING)
  sentAt    DateTime?
  error     String?
  metadata  Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("notifications")
}

model Setting {
  id                      String   @id @default(cuid())
  companyId               String   @unique
  // Branding
  primaryColor            String   @default("#2563eb")
  secondaryColor          String   @default("#f59e0b")
  faviconUrl              String?
  // Contact
  supportEmail            String?
  supportPhone            String?
  bookingEmail            String?
  // Social
  facebookUrl             String?
  instagramUrl            String?
  linkedinUrl             String?
  twitterUrl              String?
  // Features
  enableBlog              Boolean  @default(true)
  enableCareers           Boolean  @default(true)
  enableTestimonials      Boolean  @default(true)
  enableQuoteEstimator    Boolean  @default(true)
  enableWhatsApp          Boolean  @default(true)
  enableOnlineBooking     Boolean  @default(true)
  // SEO
  defaultMetaTitle        String?
  defaultMetaDescription  String?
  googleAnalyticsId       String?
  // Integrations
  googleMapsApiKey        String?
  whatsappNumber          String?
  // Defaults
  defaultCurrency         String   @default("USD")
  taxRate                 Decimal  @default(0) @db.Decimal(5, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("settings")
}

// ─────────────────────────────────────────────────────────────────
// Audit Logs
// ─────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  companyId   String?
  userId      String?
  action      String
  entityType  String
  entityId    String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
